# Supabase Configuration (Required for Cloud Sync and Multi-Provider Authentication)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Deployment & Redirect URL Notes:
# In local development and Vercel preview/production deployments, auth redirect URLs
# are dynamically resolved via window.location.origin.
# Ensure your Supabase Auth -> URL Configuration allows:
# - http://localhost:5173 (for local dev)
# - https://tracker.ojeet.tech (production domain)
# - https://*.vercel.app (preview deployments, if applicable)
